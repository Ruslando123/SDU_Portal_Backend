{
  "uid": "portal-phase6",
  "title": "SDU Portal Phase 6 Baseline",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP requests / second",
      "datasource": {
        "type": "prometheus",
        "uid": "portal-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"backend\"}[30s]))",
          "refId": "A",
          "legendFormat": "{{uri}}{{status}}{{code}}{{state}}{{event}}{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP p50 / p95 / p99",
      "datasource": {
        "type": "prometheus",
        "uid": "portal-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5,sum by(le,uri)(rate(http_server_requests_seconds_bucket{job=\"backend\"}[30s])))",
          "refId": "A",
          "legendFormat": "p50 {{uri}}"
        },
        {
          "expr": "histogram_quantile(0.95,sum by(le,uri)(rate(http_server_requests_seconds_bucket{job=\"backend\"}[30s])))",
          "refId": "B",
          "legendFormat": "p95 {{uri}}"
        },
        {
          "expr": "histogram_quantile(0.99,sum by(le,uri)(rate(http_server_requests_seconds_bucket{job=\"backend\"}[30s])))",
          "refId": "C",
          "legendFormat": "p99 {{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP 429 / 503 / 5xx rate",
      "datasource": {
        "type": "prometheus",
        "uid": "portal-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by(status)(rate(http_server_requests_seconds_count{status=~\"429|503|5..\"}[30s])) / clamp_min(sum(rate(http_server_requests_seconds_count[30s])),0.000001)",
          "refId": "A",
          "legendFormat": "{{uri}}{{status}}{{code}}{{state}}{{event}}{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
