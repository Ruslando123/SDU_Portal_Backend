# Synthetic local development only. Replace both passwords before use.
DB_NAME=sdu_registration
DB_PORT=15432
DB_URL=jdbc:postgresql://127.0.0.1:15432/sdu_registration
DB_MIGRATION_USERNAME=portal_migrator
DB_MIGRATION_PASSWORD=replace-with-a-long-random-local-password
DB_RUNTIME_PASSWORD=replace-with-a-different-long-random-password
SPRING_PROFILES_ACTIVE=dev
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=3000
PORTAL_SESSION_STORE=jdbc
# Redis mode requires a session-only ACL credential from the backend secret store.
# PORTAL_SESSION_REDIS_HOST=127.0.0.1
# PORTAL_SESSION_REDIS_PORT=6379
# PORTAL_SESSION_REDIS_USERNAME=sdu-session
# PORTAL_SESSION_REDIS_NAMESPACE=sdu:http-session:v1
